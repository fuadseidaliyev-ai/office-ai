# Copy this file to `.env`.
#
# --- Authentication: pick ONE of two ways ---
#
# Way 1 (recommended): your Claude subscription (Pro/Max plan limit).
#   Run `claude auth login` once in a terminal and leave the key below EMPTY —
#   the assistant then uses your plan's usage limit, no API billing.
#
# Way 2: an API key from https://console.anthropic.com (pay-per-use).
#   Paste it below.
ANTHROPIC_API_KEY=

# --- Model ---
# Any Claude model id the Agent SDK accepts.
ASSISTANT_MODEL=claude-sonnet-5

# --- Permission mode for system access ---
# default          -> ask before edits/commands (safest; needs a callback or CLI prompt)
# acceptEdits      -> auto-accept file edits, still guards other tools
# bypassPermissions-> run everything without asking (power user; use with care)
# plan             -> read-only planning, no changes
ASSISTANT_PERMISSION_MODE=acceptEdits

# --- Working directory the assistant operates in ---
# Defaults to your home directory. Point it at a project to scope access.
ASSISTANT_WORKDIR=

# --- Wake word ---
# The assistant sleeps until it hears this phrase, then activates. Say the
# phrase alone ("привет джарвис" -> "Да, слушаю") and give the command next,
# or say it in one breath ("привет джарвис, открой папку загрузки").
# Matching is tolerant of how speech-to-text spells the name.
# Leave empty for always-on mode (every utterance is a command).
WAKE_WORD=привет джарвис

# --- Speech-to-text ---
# Whisper model size: tiny | base | small | medium | large-v3
# Bigger = more accurate + slower. "base" is a good default on CPU.
WHISPER_MODEL=base
# cpu or cuda
WHISPER_DEVICE=cpu
# Language hint, e.g. "en", "ru". Empty = auto-detect.
STT_LANGUAGE=

# --- Microphone / VAD ---
# Aggressiveness of end-of-speech detection: 0 (lenient) .. 3 (strict)
VAD_AGGRESSIVENESS=2
# Silence (seconds) that marks the end of a spoken command.
SILENCE_TIMEOUT=1.0

# --- Text-to-speech ---
# Words per minute for the spoken replies.
TTS_RATE=185

# --- Safety ---
# Confine file writes/edits to ASSISTANT_WORKDIR. Blocks writing files
# elsewhere on the system. Dangerous shell commands (disk wipes, shutdown,
# sudo, piping downloads into a shell, ...) are ALWAYS blocked regardless.
# Set to false only if you deliberately want the assistant to write anywhere.
ASSISTANT_CONFINE_WRITES=true

# Allow the assistant to run shell commands (the Bash tool). This is the most
# powerful capability AND the biggest hole in write-confinement (a shell can
# write files many ways). Set to false for a hard boundary: no shell at all,
# only the Read/Write/Edit/Glob/Grep/Web tools + the custom system tools.
ASSISTANT_ALLOW_SHELL=true
